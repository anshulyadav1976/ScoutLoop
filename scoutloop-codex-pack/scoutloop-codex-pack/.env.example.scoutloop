# ScoutLoop core

# v0 Model API key from v0.app / v0.dev settings
V0_API_KEY=
SCOUTLOOP_MODEL=v0-1.5-md

# Mubit operational memory
MUBIT_API_KEY=
MUBIT_AGENT_ID=scoutloop

# Bright Data MCP / API
# Prefer BRIGHT_DATA_API_KEY in ScoutLoop code, but support BRIGHTDATA_API_KEY alias.
BRIGHT_DATA_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHT_DATA_MCP_URL=
BRIGHT_DATA_ZONE=

# Optional Vercel AI Gateway fallback / existing chatbot template routes
AI_GATEWAY_API_KEY=

# Optional Vercel CLI / CI deployment
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional existing Vercel Chatbot template variables
AUTH_SECRET=
NEXTAUTH_SECRET=
POSTGRES_URL=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# ScoutLoop feature flags
SCOUTLOOP_DEMO_MODE=false
SCOUTLOOP_USE_WDK=true
SCOUTLOOP_USE_MUBIT=true
SCOUTLOOP_USE_BRIGHT_DATA=true
SCOUTLOOP_MAX_TEXT_FILE_BYTES=100000
SCOUTLOOP_ENABLE_DIRECT_FALLBACK=true
